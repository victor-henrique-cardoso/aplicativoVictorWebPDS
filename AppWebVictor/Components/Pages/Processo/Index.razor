@page "/processos"

@using AppWebVictor.Model
@using AppWebVictor.DAO

@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
    <div>
        <a href="/processos/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Número</th>
            <th>Interessado</th>
            <th>Assunto</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var processo in processos)
        {
            <tr>
                <td>@processo.Id</td>
                <td>@processo.Numero</td>
                <td>@processo.Interessado</td>
                <td>@processo.Assunto</td>
                <td>@processo.Situacao</td>
                <td>
                    <button class="btn btn-primary btn-sm">
                        Editar
                    </button>

                    <button class="btn btn-danger btn-sm ms-2">
                        Excluir
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        processos = ProcessoDAO.Listar();
    }
}
